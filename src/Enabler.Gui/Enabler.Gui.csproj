<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DiscoverEnabler</AssemblyName>
    <RootNamespace>DiscoverEnabler.Gui</RootNamespace>
    <Version>1.2.0</Version>
    <Product>Discover Enabler</Product>
    <Company>mrmuiz</Company>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>DiscoverEnabler.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="DiscoverEnabler.ico" LogicalName="DiscoverEnabler.ico" />
    <EmbeddedResource Include="banner.jpg" LogicalName="banner.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enabler.Core\Enabler.Core.csproj" />
  </ItemGroup>

</Project>
