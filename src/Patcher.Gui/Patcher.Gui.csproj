<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DiscoverPatcher</AssemblyName>
    <RootNamespace>DiscoverPatcher.Gui</RootNamespace>
    <Version>1.2.0</Version>
    <Product>Discover Patcher</Product>
    <Company>mrmuiz</Company>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>DiscoverPatcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="DiscoverPatcher.ico" LogicalName="DiscoverPatcher.ico" />
    <EmbeddedResource Include="banner.jpg" LogicalName="banner.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Patcher.Core\Patcher.Core.csproj" />
  </ItemGroup>

</Project>
